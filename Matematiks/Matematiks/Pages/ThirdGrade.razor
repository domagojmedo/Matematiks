@page "/thirdgrade"

@inject ISessionService _sessionService;

<PageTitle>Third Grade</PageTitle>

<h1 class="display-1"> @left @sign @right = @result</h1>

<NumPad Input="Input" Delete="Delete" />

<p> @correctCounter | @deleteCounter </p>

@code {
    private int left = 0;
    private int right = 0;
    private string sign = string.Empty;

    private Operations currentOperation;
    private List<Operations> operations = [Operations.Addition, Operations.Subtraction];

    private string result = string.Empty;

    private int correctCounter = 0;
    private int deleteCounter = 0;

    private Session session = new(SessionType.ThirdGrade);

    private void Generate()
    {
        currentOperation = operations[Random.Shared.Next(operations.Count)];

        // First number is 3 digits (100-999)
        left = Random.Shared.Next(100, 1000);

        // Second number is 1 digit (1-9)
        right = Random.Shared.Next(1, 10);

        if (currentOperation == Operations.Addition)
        {
            sign = "+";
        }
        else if (currentOperation == Operations.Subtraction)
        {
            sign = "-";
        }

        result = string.Empty;
    }

    private void Input(int number)
    {
        // Result can be up to 4 digits (e.g., 999 + 9 = 1008)
        if (result.Count() >= 4)
        {
            return;
        }

        result += number;

        if (int.TryParse(result, out var intResult))
        {
            var operationResult = currentOperation switch
            {
                Operations.Addition => left + right,
                Operations.Subtraction => left - right,
                _ => 0
            };

            if (intResult == operationResult)
            {
                correctCounter++;

                session.CorrectCounter = correctCounter;

                SaveState();
                Generate();
            }
        }
    }

    private void Delete()
    {
        if (string.IsNullOrWhiteSpace(result))
        {
            return;
        }

        // Clear the entire input instead of just removing one character
        result = string.Empty;
        deleteCounter++;

        session.DeleteCounter = deleteCounter;
        SaveState();
    }

    protected override Task OnInitializedAsync()
    {
        Generate();

        return base.OnInitializedAsync();
    }

    private void SaveState()
    {
        session.LastActionTime = DateTime.Now;
        _sessionService.SaveSession(session);
    }
}
