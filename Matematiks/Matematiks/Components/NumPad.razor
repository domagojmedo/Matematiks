@namespace Matematiks.Components
@using Microsoft.JSInterop
@inject IJSRuntime JS

<div class="btn-group-vertical ml-4 mt-4 container" role="group" aria-label="Basic example">
    <div class="btn-group">
        <button type="button" class="btn btn-outline-primary py-3" @onclick="_ => OnInput(1)">1</button>
        <button type="button" class="btn btn-outline-primary py-3" @onclick="_ => OnInput(2)">2</button>
        <button type="button" class="btn btn-outline-primary py-3" @onclick="_ => OnInput(3)">3</button>
    </div>
    <div class="btn-group">
        <button type="button" class="btn btn-outline-primary py-3" @onclick="_ => OnInput(4)">4</button>
        <button type="button" class="btn btn-outline-primary py-3" @onclick="_ => OnInput(5)">5</button>
        <button type="button" class="btn btn-outline-primary py-3" @onclick="_ => OnInput(6)">6</button>
    </div>
    <div class="btn-group">
        <button type="button" class="btn btn-outline-primary py-3" @onclick="_ => OnInput(7)">7</button>
        <button type="button" class="btn btn-outline-primary py-3" @onclick="_ => OnInput(8)">8</button>
        <button type="button" class="btn btn-outline-primary py-3" @onclick="_ => OnInput(9)">9</button>
    </div>
    <div class="btn-group">
        <button type="button" class="btn btn-outline-primary py-3" @onclick="OnDelete">C</button>
        <button type="button" class="btn btn-outline-primary py-3" @onclick="_ => OnInput(0)">0</button>
    </div>
</div>

<style>
    .btn-group > button {
        height:150px;
        font-size: 50px;
        -webkit-tap-highlight-color: transparent;
        transition: all 0.15s ease-in-out;
    }

    /* Prevent hover states on touch devices */
    .btn-group > button:hover {
        background-color: transparent;
        border-color: #0d6efd;
        color: #0d6efd;
    }

    /* Override Bootstrap's hover state more aggressively */
    .btn-outline-primary:hover {
        background-color: transparent !important;
        border-color: #0d6efd !important;
        color: #0d6efd !important;
    }

    /* Ensure focus state doesn't persist */
    .btn-group > button:focus,
    .btn-outline-primary:focus {
        background-color: transparent !important;
        border-color: #0d6efd !important;
        color: #0d6efd !important;
        box-shadow: none !important;
    }

    /* Active state for visual feedback when clicked */
    .btn-group > button:active,
    .btn-outline-primary:active {
        background-color: #0d6efd !important;
        border-color: #0d6efd !important;
        color: white !important;
        transform: scale(0.95);
        transition: all 0.1s ease-in-out;
    }

    /* Custom class for programmatic click feedback */
    .btn-clicked {
        background-color: #0d6efd !important;
        border-color: #0d6efd !important;
        color: white !important;
        transform: scale(0.95);
    }
</style>

@code {
    [Parameter]
    public EventCallback<int> Input { get; set; }

    [Parameter]
    public EventCallback Delete { get; set; }

    private async Task OnInput(int number)
    {
        await Input.InvokeAsync(number);
        await RemoveFocusFromActiveElement();
    }

    private async Task OnDelete()
    {
        await Delete.InvokeAsync();
        await RemoveFocusFromActiveElement();
    }

    private async Task RemoveFocusFromActiveElement()
    {
        await Task.Delay(100); // Small delay to ensure the click event is processed
        await JS.InvokeVoidAsync("eval", @"
            const activeElement = document.activeElement;
            if (activeElement && activeElement.tagName === 'BUTTON') {
                activeElement.classList.add('btn-clicked');
                setTimeout(() => {
                    activeElement.classList.remove('btn-clicked');
                    activeElement.blur();
                }, 150);
            }
        ");
    }
}